import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";

export struct SidebarFolder {
    name: string,
    selected: bool,
}

export struct TreeRow {
    name: string,
    path: string,
    level: int,
    is-folder: bool,
    expanded: bool,
    selected: bool,
}

export component AppWindow inherits Window {
    in property <[SidebarFolder]> sidebar-folders;
    in property <[TreeRow]> tree-rows;

    in-out property <string> search-query: "";
    in-out property <int> active-tab: 0;
    in-out property <string> status-text: "Ready";

    callback sidebar-folder-selected(int);
    callback tree-row-selected(int);
    callback tab-selected(int);
    callback search(string);

    min-width: 900px;
    min-height: 560px;
    max-width: 6000px;
    max-height: 4000px;
    preferred-width: 1280px;
    preferred-height: 760px;
    title: @tr("Cabinets");
    icon: @image-url("../resources/logo/rust-logo-512x512-4060026730.png");
    background: #e9e9ec;

    Rectangle {
        border-width: 1px;
        border-color: #c9c9cf;
        border-radius: 12px;
        background: #f3f3f6;

        VerticalBox {
            spacing: 0px;

            Rectangle {
                height: 62px;
                background: #ececf0;

                HorizontalBox {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 11px;
                    padding-bottom: 11px;
                    spacing: 10px;

                    Rectangle {
                        border-width: 1px;
                        border-color: #c6c7cf;
                        border-radius: 8px;
                        background: #e5e5eb;
                        horizontal-stretch: 1;
                        height: 38px;

                        HorizontalBox {
                            padding-left: 6px;
                            padding-right: 6px;
                            padding-top: 5px;
                            padding-bottom: 5px;
                            spacing: 6px;

                            Rectangle {
                                width: 84px;
                                border-width: 1px;
                                border-color: #b4bac6;
                                border-radius: 6px;
                                background: root.active-tab == 0 ? #d6dcea : #e5e5eb;

                                Text {
                                    x: 23px;
                                    y: 6px;
                                    text: "Tree";
                                    color: #30323a;
                                }

                                TouchArea {
                                    clicked => { root.tab-selected(0); }
                                }
                            }

                            Rectangle {
                                width: 84px;
                                border-width: 1px;
                                border-color: #b4bac6;
                                border-radius: 6px;
                                background: root.active-tab == 1 ? #d6dcea : #e5e5eb;

                                Text {
                                    x: 16px;
                                    y: 6px;
                                    text: "Folders";
                                    color: #30323a;
                                }

                                TouchArea {
                                    clicked => { root.tab-selected(1); }
                                }
                            }

                            Rectangle {
                                width: 84px;
                                border-width: 1px;
                                border-color: #b4bac6;
                                border-radius: 6px;
                                background: root.active-tab == 2 ? #d6dcea : #e5e5eb;

                                Text {
                                    x: 25px;
                                    y: 6px;
                                    text: "Files";
                                    color: #30323a;
                                }

                                TouchArea {
                                    clicked => { root.tab-selected(2); }
                                }
                            }
                        }
                    }

                    Rectangle {
                        width: 300px;
                        border-width: 1px;
                        border-color: #c6c8d1;
                        border-radius: 10px;
                        background: #ffffff;
                        height: 38px;

                        HorizontalBox {
                            padding-left: 8px;
                            padding-right: 6px;
                            padding-top: 5px;
                            padding-bottom: 5px;
                            spacing: 6px;

                            Text {
                                text: "🔎";
                                color: #6e717b;
                                y: 4px;
                            }

                            LineEdit {
                                text <=> root.search-query;
                                placeholder-text: "Search";
                                accepted => {
                                    root.search(root.search-query);
                                }
                                horizontal-stretch: 1;
                            }

                            Button {
                                text: "Go";
                                clicked => {
                                    root.search(root.search-query);
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    x: 0px;
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: #ccced7;
                }
            }

            HorizontalBox {
                spacing: 0px;

                Rectangle {
                    width: 240px;
                    background: #ebecf2;

                    VerticalBox {
                        padding-left: 14px;
                        padding-right: 12px;
                        padding-top: 14px;
                        padding-bottom: 8px;
                        spacing: 8px;

                        Text {
                            text: "Home";
                            color: #666b78;
                            font-size: 12px;
                        }

                        ScrollView {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;

                            VerticalBox {
                                padding-left: 0px;
                                padding-right: 0px;
                                padding-top: 0px;
                                padding-bottom: 0px;
                                spacing: 8px;

                                for folder[i] in root.sidebar-folders: Rectangle {
                                    height: 30px;
                                    border-radius: 8px;
                                    background: folder.selected ? #d8e7ff : #ebecf2;

                                    Text {
                                        x: 10px;
                                        y: 6px;
                                        text: "📁 " + folder.name;
                                        color: folder.selected ? #1f5faa : #273043;
                                    }

                                    TouchArea {
                                        clicked => {
                                            root.sidebar-folder-selected(i);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        y: 0px;
                        height: parent.height;
                        background: #ccced7;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: #ffffff;

                    VerticalBox {
                        spacing: 0px;

                        Rectangle {
                            height: 34px;
                            background: #ffffff;

                            Text {
                                x: 14px;
                                y: 8px;
                                text: "Name";
                                color: #707686;
                                font-size: 12px;
                            }

                            Rectangle {
                                x: 0px;
                                y: parent.height - 1px;
                                width: parent.width;
                                height: 1px;
                                background: #eaecf1;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            background: #ffffff;

                            ScrollView {
                                horizontal-stretch: 1;
                                vertical-stretch: 1;

                                VerticalBox {
                                    padding-left: 10px;
                                    padding-right: 12px;
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    spacing: 2px;

                                    for row[i] in root.tree-rows: Rectangle {
                                        height: 28px;
                                        border-radius: 6px;
                                        background: row.selected ? #cce3ff : #ffffff;

                                        Text {
                                            x: 8px + row.level * 18px;
                                            y: 6px;
                                            text: row.is-folder ? (row.expanded ? "▼ 📁 " : "▶ 📁 ") + row.name : "  📄 " + row.name;
                                            color: row.selected ? #154a89 : #1e2532;
                                        }

                                        TouchArea {
                                            clicked => {
                                                root.tree-row-selected(i);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 28px;
                            background: #f5f6fa;

                            Rectangle {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: 1px;
                                background: #dadde5;
                            }

                            Text {
                                x: 12px;
                                y: 6px;
                                text: root.status-text;
                                color: #697084;
                            }
                        }
                    }
                }
            }
        }
    }
}